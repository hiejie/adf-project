<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Login · ADF 2027</title>
  <style>
    :root {
      --cream: #f8f7df; --orange: #f9dca6; --red: #c9272d; --red-button: #ce2b2f;
      --navy: #162b45; --white: #ffffff; --dark-text: #333333; --muted: #8c8c8c;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0; min-height: 100vh; display: flex; align-items: center; justify-content: center;
      background: var(--navy); font-family: "Segoe UI", Arial, sans-serif; color: var(--dark-text);
    }
    .login-card {
      width: min(90%, 380px); background: var(--white); border-radius: 14px;
      padding: 36px 32px; box-shadow: 0 20px 45px rgba(0,0,0,0.35);
    }
    h1 { margin: 0 0 4px; color: var(--red); font-size: 1.5rem; }
    p.sub { margin: 0 0 24px; color: var(--muted); font-size: 0.85rem; }
    label { display: block; margin-bottom: 6px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; color: var(--navy); }
    input { width: 100%; height: 42px; border: 1px solid rgba(22,43,69,0.3); border-radius: 8px; padding: 0 12px; margin-bottom: 18px; font: inherit; }
    button {
      width: 100%; height: 44px; border: none; border-radius: 30px; background: var(--red-button);
      color: var(--white); font-weight: 700; text-transform: uppercase; font-size: 0.8rem; cursor: pointer;
    }
    button:hover { opacity: 0.92; }
    .error {
      margin-bottom: 18px; padding: 10px 12px; border-radius: 8px; background: #fdecea;
      color: var(--red); font-size: 0.8rem;
    }
  </style>
</head>
<body>
  <div class="login-card">
    <h1>ADF 2027 Admin</h1>
    <p class="sub">Sign in to view registrations and messages.</p>
    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>
    <form method="post" action="/admin/login">
      <label for="username">Username</label>
      <input id="username" name="username" type="text" autocomplete="username" required>
      <label for="password">Password</label>
      <input id="password" name="password" type="password" autocomplete="current-password" required>
      <button type="submit">Log in</button>
    </form>
  </div>
</body>
</html>
