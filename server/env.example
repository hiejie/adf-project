# Copy this file to .env and fill in real values.
# NEVER commit the real .env file — it's already git-ignored.

# ---------- Core ----------
NODE_ENV=development
PORT=3000
# Public URL of your deployed site, no trailing slash (used in emails/links).
SITE_URL=

# ---------- Sessions / admin auth ----------
# Any long random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# REQUIRED (server refuses to start without a real value when NODE_ENV=production).
SESSION_SECRET=

ADMIN_USERNAME=admin
# Generate with: npm run seed-admin -- "yourStrongPassword123"
# REQUIRED in production.
ADMIN_PASSWORD_HASH=

# ---------- Screenshot encryption ----------
# Campus++ screenshots are encrypted at rest (AES-256-GCM) using this key.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED in every environment — the app will not start without it.
# If you ever rotate this key, existing encrypted screenshots become
# unreadable, so back it up somewhere safe (a password manager, not git).
UPLOAD_ENCRYPTION_KEY=

# ---------- Storage location overrides (optional) ----------
# Leave both blank for local dev — they default to folders next to the code.
# On a host with a mounted persistent disk (Render, Railway, etc.), point
# these at the disk's mount path instead. Don't mount a disk directly over
# the default folders — see the comments in db.js / middleware/upload.js.
DATA_DIR=
UPLOAD_DIR=

# ---------- Event details (used in emails / confirmation text) ----------
EVENT_NAME=A Day with the Foxes 2027
EVENT_DATE_TEXT=February 23, 2027
EVENT_VENUE=Holy Angel University, School of Computing — #1 Holy Angel Avenue, Sto. Rosario, Angeles City, Philippines 2009

# ---------- Outbound email (registration confirmations) ----------
# Leave SMTP_HOST blank to skip email sending entirely (registration still works).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="A Day with the Foxes 2027 <no-reply@yourdomain.edu>"

# Optional: if set (and SMTP is configured above), organizers get an email
# every time a new contact-form message comes in.
ADMIN_NOTIFY_EMAIL=
